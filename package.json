{
  "name": "couple-task-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test",
    "build": "vite build --mode demo",
    "dev": "pnpm run build && concurrently -k 'wrangler dev --local --port 8787 --env local' 'vite --host 127.0.0.1'",
    "preview:worker": "wrangler dev --local --port 8787 --env local",
    "seed:local": "tsx scripts/seed-local.ts",
    "build:production": "vite build --mode production",
    "build:dev": "vite build --mode dev"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "firebase": "13.1.0",
    "jose": "6.2.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.12",
    "@cloudflare/workers-types": "5.20261102.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "fake-indexeddb": "6.2.7",
    "firebase-tools": "15.34.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
