{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shared-task-board",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "env": {
    "local": {
      "main": "src/worker/local.ts",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shared-task-board",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "AUTH_MODE": "emulator",
        "FIREBASE_PROJECT_ID": "demo-shared-task-board",
        "ENVIRONMENT": "local",
      },
    },
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shared-task-board-dev",
          "database_id": "09ad1f2f-026e-4e80-8dc8-1ae3f6cd242e",
          "migrations_dir": "migrations",
        },
        {
          "binding": "shared_task_board_dev",
          "database_name": "shared-task-board-dev",
          "database_id": "09ad1f2f-026e-4e80-8dc8-1ae3f6cd242e",
          "remote": true,
        },
      ],
      "vars": {
        "AUTH_MODE": "production",
        "FIREBASE_PROJECT_ID": "couple-task-scheduler",
      },
    },
  },
}
